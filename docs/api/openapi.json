    "/api/v1/account/logout": {
      "post": {
        "parameters": [],
        "responses": {},
        "security": [],
        "tags": [
          "AccessTokens"
        ]
      }
    },
    "/api/v1/account/profile": {
      "get": {
        "parameters": [],
        "responses": {},
        "security": [],
        "tags": [
          "Profile"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "parameters": [],
        "responses": {},
        "security": [],
        "tags": [
          "AccessTokens"
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "parameters": [],
        "responses": {},
        "security": [],
        "tags": [
          "NewAccount"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "description": "Devuelve el mismo conjunto para cualquier cuenta que pida el mismo alcance, de la más reciente a la más antigua y sin paginar. Sin acotar, el alcance son las pendientes y las que están en curso; las hechas se quedan fuera y solo se alcanzan pidiéndolas por su estado. No informa del vencimiento, y por eso no pide día de referencia.",
        "parameters": [
          {
            "description": "Acota la lista a un estado. El estado es la única dimensión por la que se puede acotar. Sin él llegan `pending` e `in_progress`. Hoy el validador solo comprueba que sea texto, así que un valor fuera de estos tres no se rechaza: devuelve una lista vacía.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "pending",
                "in_progress",
                "done"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            },
            "description": "La lista del alcance pedido, entera. Ninguna tarea trae fecha ni condición de vencida."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido. No se devuelve ninguna tarea."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "La lista compartida del espacio",
        "tags": [
          "Tasks"
        ]
      },
      "post": {
        "description": "El título es el único dato que se lee. La tarea nace en `pending` y a nombre de la cuenta dueña del token: un `status` o un responsable enviados en el cuerpo se ignoran, no se rechazan. Tampoco admite fecha de vencimiento, que se pone después con `PUT /tasks/{id}/due-date`.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "La tarea ya creada, en `pending` y a nombre de quien la envió."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido. No se crea ninguna tarea."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "El título falta, está vacío, es solo espacios o pasa de 200 caracteres. No se crea ninguna tarea ni se guarda una versión recortada."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crear una tarea con solo el título",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "description": "Devuelve la tarea entera —fecha de vencimiento incluida, o su ausencia— con `isOverdue` ya resuelto contra el día que indique quien pregunta. No comprueba quién es el responsable: una tarea ajena llega igual que una propia, y mirarla no la cambia.",
        "parameters": [
          {
            "description": "Día de referencia `AAAA-MM-DD` contra el que se decide el vencimiento. Obligatorio y sin valor por defecto: el sistema no sustituye el día que falte por el de su propio reloj.",
            "example": "2026-08-27",
            "in": "query",
            "name": "today",
            "required": true,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                }
              }
            },
            "description": "La tarea, con su fecha de vencimiento y su condición de vencida."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido. No se devuelve ninguna tarea."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No existe ninguna tarea con ese identificador."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "Falta `today` o no es una fecha válida. No se devuelve ninguna tarea."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Una tarea suelta, con su vencimiento resuelto",
        "tags": [
          "Tasks"
        ]
      }
    },
    "/api/v1/tasks/{id}/due-date": {
      "put": {
        "description": "Las tres cosas son la misma operación: enviar una fecha la pone o la sustituye, y enviar `null` la retira, que es una operación admitida y no un error. Se acepta una fecha ya pasada sin advertir nada. El título, el responsable y el estado siguen igual. Cualquier cuenta con sesión puede hacerlo sobre cualquier tarea.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetTaskDueDateBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                }
              }
            },
            "description": "La tarea con la fecha ya actualizada y su `isOverdue` resuelto contra el `today` enviado, de modo que aplazar una tarea vencida deja de mostrarla vencida en esta misma respuesta."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido. Nada cambia."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No existe ninguna tarea con ese identificador. Se comprueba antes que el cuerpo."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "`dueDate` es una fecha imposible o mal formada, o falta `today` o no vale. La tarea conserva intacta la fecha que tuviera."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Fijar, cambiar o retirar la fecha de vencimiento",
        "tags": [
          "TaskDueDates"
        ]
      }
    },
    "/api/v1/tasks/{id}/status": {
      "patch": {
        "description": "Cualquier cuenta con sesión cambia el estado de cualquier tarea, sea o no la responsable, y en cualquier dirección: volver de `done` a `pending` está permitido. El título y el responsable no se tocan. Responde con la forma de lista, sin fecha ni condición de vencida, así que no pide día de referencia.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskStatusBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "La tarea ya en el estado de destino."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Falta el token o no es válido. Nada cambia."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No existe ninguna tarea con ese identificador. Se comprueba antes que el cuerpo."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            },
            "description": "El estado falta o no es uno de los tres. La tarea conserva el que tenía y el estado inventado no pasa a existir."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cambiar el estado de una tarea",
        "tags": [
          "TaskStatuses"
        ]
      }
    }
  }
}
