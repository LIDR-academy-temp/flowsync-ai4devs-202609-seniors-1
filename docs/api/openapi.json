{
  "components": {
    "schemas": {
      "CreateTaskBody": {
        "properties": {
          "title": {
            "description": "Se recortan los espacios de los extremos antes de comprobar la longitud: un título de solo espacios se rechaza igual que uno vacío, y pasarse de 200 es un error, nunca un recorte.",
            "example": "Revisar el informe",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "ErrorItem": {
        "properties": {
          "message": {
            "example": "Unauthorized access",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      },
      "SetTaskDueDateBody": {
        "properties": {
          "dueDate": {
            "description": "`null` retira la fecha, y es un valor legítimo del campo, no un error.",
            "example": "2026-09-30",
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "today": {
            "description": "Día de referencia con el que se resuelve `isOverdue` en la respuesta. Obligatorio y sin valor por defecto.",
            "example": "2026-08-27",
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "dueDate",
          "today"
        ],
        "type": "object"
      },
      "Task": {
        "properties": {
          "assignee": {
            "$ref": "#/components/schemas/TaskAssignee"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "example": 1,
            "type": "number"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "pending",
            "type": "string"
          },
          "title": {
            "example": "Revisar el informe",
            "maxLength": 200,
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "assignee",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "TaskAssignee": {
        "properties": {
          "fullName": {
            "description": "Nulo cuando la cuenta se registró sin nombre. Las iniciales siguen llegando.",
            "example": "Ada Lovelace",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "example": 1,
            "type": "number"
          },
          "initials": {
            "example": "AL",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fullName",
          "initials"
        ],
        "type": "object"
      },
      "TaskDetail": {
        "properties": {
          "assignee": {
            "$ref": "#/components/schemas/TaskAssignee"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dueDate": {
            "description": "Día del calendario `AAAA-MM-DD`, sin hora ni huso. Nulo si la tarea no tiene.",
            "example": "2026-09-30",
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "example": 1,
            "type": "number"
          },
          "isOverdue": {
            "description": "Resuelto contra el `today` de la petición: hay fecha, es anterior a ese día y el estado no es `done`.",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "pending",
            "type": "string"
          },
          "title": {
            "example": "Revisar el informe",
            "maxLength": 200,
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "dueDate",
          "isOverdue",
          "assignee",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "TaskDetailResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskDetail"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TaskListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TaskResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "UpdateTaskStatusBody": {
        "properties": {
          "status": {
            "description": "Cualquiera de los tres estados. Todas las transiciones valen, incluida la vuelta desde `done`.",
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "example": "in_progress",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ValidationErrorItem": {
        "properties": {
          "field": {
            "example": "title",
            "type": "string"
          },
          "message": {
            "example": "The title field must be defined",
            "type": "string"
          },
          "rule": {
            "example": "required",
            "type": "string"
          }
        },
        "required": [
          "message",
          "rule",
          "field"
        ],
        "type": "object"
      },
      "ValidationErrorResponse": {
        "properties": {
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ValidationErrorItem"
            },
            "type": "array"
          }
        },
        "required": [
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Access token opaco emitido por `POST /api/v1/auth/login`, en la cabecera `Authorization: Bearer <token>`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "FlowSync API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
