SESSION_DRIVER=memory

# Las pruebas van SIEMPRE contra `db-test` (compose.yaml, puerto 54411, en
# memoria). Este fichero lo carga el framework solo con NODE_ENV=test y sus
# valores tienen prioridad sobre los de `.env`, así que las cinco variables se
# declaran todas: si faltara una, se heredaría la de desarrollo.
# Credenciales locales de usar y tirar, no son secretos.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync_test
DB_PASSWORD=flowsync_test
DB_DATABASE=flowsync_test
