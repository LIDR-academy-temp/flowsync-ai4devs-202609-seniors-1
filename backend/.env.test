SESSION_DRIVER=memory

# PostgreSQL de pruebas: servicio `db-test` de compose.yaml, en memoria.
# Las cinco DB_* van aquí aunque coincidan con las de `.env`: el loader de
# AdonisJS rellena con `.env` lo que falte en `.env.test`, así que una sola que
# faltara se tomaría de desarrollo sin avisar. `tests/bootstrap.ts` lo vigila.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
