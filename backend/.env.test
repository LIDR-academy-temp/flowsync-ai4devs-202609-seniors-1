SESSION_DRIVER=memory

# Las pruebas van contra `db-test` de compose.yaml (en memoria, sin volumen),
# nunca contra la base de desarrollo. AdonisJS carga este fichero solo cuando
# NODE_ENV=test (lo fija bin/test.ts), y sus valores mandan sobre los de `.env`.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
