# Lo carga el framework solo cuando NODE_ENV=test (lo fija bin/test.ts) y
# sobrescribe lo que haya en .env. Apunta la batería a `db-test` (54411).
SESSION_DRIVER=memory

# Database — servicio `db-test` de compose.yaml (pruebas, en memoria)
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
