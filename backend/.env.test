SESSION_DRIVER=memory

# Base de pruebas: el servicio db-test de compose.yaml, en memoria. Este archivo
# solo se carga con NODE_ENV=test y sus valores pisan a los de .env, así que las
# pruebas nunca tocan la base de desarrollo.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
