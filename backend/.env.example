# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Base de datos: servicio `db` de compose.yaml (PostgreSQL 17, puerto 54410)
# Credenciales locales de desarrollo; tienen que coincidir con compose.yaml.
#--------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync
